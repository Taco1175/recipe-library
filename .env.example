# Copy this file to .env and fill in your values

# PocketBase — internal URL (default: http://localhost:8090)
PB_URL=http://localhost:8090

# PocketBase admin credentials — needed for login-alert notifications
# (These are the same credentials you use for the PocketBase Admin UI)
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=your-admin-password

# Resend — used for share invite emails AND carrier SMS gateways
RESEND_API_KEY=your-resend-key-here
EMAIL_FROM=noreply@mealplannr.xyz

# Optional — AI ingredient suggestions
ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional — port for the Node API server (default: 3000)
PORT=3000

# ── PocketBase collections to create ─────────────────────────────────────────
# 1. user_preferences  — add a "notifications" Text field (stores JSON)
# 2. app_settings      — new collection with one "allowed_emails" Text field
#    List/View rules:   (empty — public read)
#    Create/Update rules: @request.auth.id != "" (any signed-in user can write)
