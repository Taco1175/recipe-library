# Copy this file to .env and fill in your values

# PocketBase — internal URL (default: http://localhost:8090)
PB_URL=http://localhost:8090

# Optional — only needed for AI ingredient suggestions
ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional — port for the Node API server (default: 3000)
PORT=3000

# ── SMS / Notification settings ───────────────────────────────────────────────
# Resend API key (already used for share invite emails — same key works for SMS)
RESEND_API_KEY=your-resend-key-here
EMAIL_FROM=noreply@mealplannr.xyz

# Owner phone for security alerts (unauthorized login attempts)
# OWNER_PHONE=5551234567          ← digits only, no dashes
# OWNER_CARRIER=verizon           ← att | verizon | tmobile | sprint | uscellular | boost | cricket | metro

# Comma-separated list of Google emails allowed to log in via OAuth.
# Leave blank to allow anyone (open registration).
# ALLOWED_EMAILS=you@gmail.com,family@gmail.com

# ── PocketBase schema note ────────────────────────────────────────────────────
# Add a "notifications" Text field to the user_preferences collection in PocketBase
# Admin UI → Collections → user_preferences → New field → Text → name: notifications
